# Enable Powerlevel10k instant prompt.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ==================================
# AM | Zsh Configuration
# ==================================

export EDITOR=nvim
export VISUAL=nvim
export TERMUX_HOME="$HOME"

# Colors
autoload -Uz colors && colors

# Custom LS_COLORS — distinct colors per language
export LS_COLORS="di=1;34:ln=1;36:so=1;35:pi=33:ex=1;32:bd=1;33:cd=1;33:su=1;31:sg=1;31:tw=1;32:ow=1;34:st=1;34:*.py=1;33:*.pyc=0;90:*.pyo=0;90:*.java=1;35:*.class=0;90:*.c=1;36:*.h=1;36:*.cpp=1;32:*.cc=1;32:*.cxx=1;32:*.hpp=1;32:*.cs=1;34:*.go=1;36:*.rs=1;33:*.js=1;33:*.ts=1;34:*.jsx=1;36:*.tsx=1;36:*.rb=1;31:*.php=1;35:*.swift=1;33:*.kt=1;35:*.sh=1;32:*.zsh=1;32:*.bash=1;32:*.json=1;33:*.yml=1;35:*.yaml=1;35:*.toml=1;35:*.xml=1;34:*.html=1;31:*.css=1;35:*.md=1;37:*.txt=0;37:*.zip=1;31:*.tar=1;31:*.gz=1;31:*.xz=1;31:*.7z=1;31:*.rar=1;31:*.png=1;35:*.jpg=1;35:*.jpeg=1;35:*.gif=1;35:*.svg=1;35:*.mp3=1;36:*.mp4=1;36:*.mkv=1;36:*.pdf=1;31:*.log=0;37:*.conf=1;34:*.env=1;33:*.gitignore=0;90:*.lock=0;90"

# eza options
export EZA_ICON_SPACING=2
export EZA_ICONS_AUTO=1

# Useful aliases
alias ls='eza --icons --group-directories-first'
alias ll='eza -lah --icons --git --group-directories-first'
alias la='eza -a --icons --group-directories-first'
alias lt='eza --tree --level=2 --icons'
alias l='eza -1 --icons'
alias c='clear'
alias v='nvim'
alias zconf='nvim ~/.zshrc'
alias reload='source ~/.zshrc'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Completion
autoload -Uz compinit
compinit

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=5000
SAVEHIST=5000
setopt HIST_IGNORE_DUPS
setopt SHARE_HISTORY
setopt INTERACTIVE_COMMENTS

# AM: Zsh Plugins
source "$HOME/.config/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
source "$HOME/.config/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# Powerlevel10k
source "$HOME/.config/zsh/plugins/powerlevel10k/powerlevel10k.zsh-theme"

# Load personal prompt settings
[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"

# AM custom prompt segment
POWERLEVEL9K_CUSTOM_AM='echo "󰀄 𝙰𝙼"'
POWERLEVEL9K_CUSTOM_AM_BACKGROUND=234
POWERLEVEL9K_CUSTOM_AM_FOREGROUND=39

# ============================================
# AM: Force prompt shortening → /sdc/Download
# MUST be last so it overrides .p10k.zsh
# ============================================
typeset -g POWERLEVEL9K_SHORTEN_STRATEGY=truncate_from_right
typeset -g POWERLEVEL9K_SHORTEN_DIR_LENGTH=3
typeset -g POWERLEVEL9K_SHORTEN_DELIMITER=''
typeset -g POWERLEVEL9K_DIR_MAX_LENGTH=0
typeset -g POWERLEVEL9K_DIR_MIN_COMMAND_COLUMNS=0
typeset -g POWERLEVEL9K_DIR_MIN_COMMAND_COLUMNS_PCT=0
